OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Convex (auth is Convex Auth; its secrets live on the Convex deployment, not here).
# Also copy VITE_CONVEX_URL into insightful-property-hub/.env.local for local Vite dev.
# Hosted portal: set VITE_CONVEX_URL (or CONVEX_URL) on the frontend server/container.
# Convex dashboard variables do not configure the frontend server. Runtime values
# override the build-time Vite URL; only this public URL is sent to the browser.
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud
WINDMILL_MCP_URL=http://your-windmill-host/api/mcp/w/your-workspace/mcp?token=your-token
WINDMILL_MCP_TIMEOUT_MS=120000
WINDMILL_SCANNER_DETECT_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/detect_document_edges
WINDMILL_SCANNER_PROCESS_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/scan_document_image
WINDMILL_SCANNER_GENERATE_PDF_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/generate_scanned_pdf
WINDMILL_SCANNER_SAVE_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/save_scanned_document
WINDMILL_SCANNER_BEARER_TOKEN=your-windmill-bearer-token
CLI_SERVER_BASE_URL=http://your-cli-server-host
PRINTING_PRESS_FACEBOOK_MARKETPLACE_CLI_PATH=C:\Users\YourUser\AppData\Local\Programs\PrintingPress\bin\facebook-marketplace-pp-cli.exe
# Optional: Mastra base URL for agent REST calls (defaults to MASTRA_CHAT_URL without /chat)
MASTRA_API_URL=
# Sourcing: configure this token on BOTH Mastra and the Convex deployment.
# Use a long randomly generated secret; never set a VITE_ variable for it.
MASTRA_SOURCING_SERVICE_TOKEN=
# Convex deployment only: full reachable Mastra endpoint URL (not localhost in hosted Convex).
# Combined portal/Mastra container: https://your-portal-host/api/sourcing/research
# Standalone Mastra: https://your-mastra-host/sourcing/research
MASTRA_SOURCING_URL=

# --- Voice dictation + voice assistant (insightful-property-hub/docs/voice.md) ---
# Portal server: OpenRouter speech-to-text model (uses OPENROUTER_API_KEY above).
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
# Portal server: largest accepted recording in bytes (default 8 MB).
VOICE_MAX_AUDIO_BYTES=8388608
# Browser (build-time): max recording length in seconds, auto-stops at the limit (default 60).
VITE_VOICE_MAX_RECORDING_SECONDS=60
# Portal server AND Mastra: shared secret for POST /voice/assist (same value on both).
MASTRA_VOICE_SERVICE_TOKEN=
# Mastra: model for the voice assistant agent (falls back to OPENROUTER_MODEL).
VOICE_ASSISTANT_MODEL=openai/gpt-4.1-mini
# Convex deployment env (set with `npx convex env set`, not here): VOICE_RATE_LIMIT_PER_MINUTE (default 10),
# VOICE_DAILY_CAP (default 200) per user across dictation and assistant requests.
