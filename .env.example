OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Convex (auth is Convex Auth; its secrets live on the Convex deployment, not here).
# Also copy VITE_CONVEX_URL into insightful-property-hub/.env.local for local Vite dev.
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud
WINDMILL_MCP_URL=http://your-windmill-host/api/mcp/w/your-workspace/mcp?token=your-token
WINDMILL_MCP_TIMEOUT_MS=120000
WINDMILL_SCANNER_DETECT_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/detect_document_edges
WINDMILL_SCANNER_PROCESS_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/scan_document_image
WINDMILL_SCANNER_GENERATE_PDF_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/generate_scanned_pdf
WINDMILL_SCANNER_SAVE_URL=https://your-windmill-host/api/w/your-workspace/jobs/run_wait_result/p/f/docling/scanner/save_scanned_document
WINDMILL_SCANNER_BEARER_TOKEN=your-windmill-bearer-token
CLI_SERVER_BASE_URL=http://your-cli-server-host
PRINTING_PRESS_FACEBOOK_MARKETPLACE_CLI_PATH=C:\Users\YourUser\AppData\Local\Programs\PrintingPress\bin\facebook-marketplace-pp-cli.exe

