{
  "name": "web-research-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n MASTRA,WEB -c cyan,magenta \"npm run dev:mastra\" \"npm run dev:web\"",
    "dev:all": "npm run dev",
    "dev:mastra": "node scripts/mastra-openrouter.mjs dev",
    "dev:web": "npm run dev --prefix insightful-property-hub",
    "studio": "node scripts/mastra-openrouter.mjs studio",
    "build": "npm run build:web",
    "build:web": "npm run build --prefix insightful-property-hub",
    "build:mastra": "node scripts/mastra-openrouter.mjs build --studio",
    "start": "node scripts/start-insightful-property-hub.mjs",
    "start:web": "node scripts/start-insightful-property-hub.mjs",
    "start:mastra": "node scripts/mastra-openrouter.mjs start",
    "start:platform": "node scripts/start-platform.mjs",
    "wmill:pull": "wmill sync pull --workspace cyphersoft --yes --skip-branch-validation",
    "wmill:push": "wmill sync push --workspace cyphersoft --yes --skip-branch-validation",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/mastra": "2.0.1",
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@copilotkit/runtime": "1.79.1",
    "@mastra/ai-sdk": "^1.10.5",
    "@mastra/client-js": "1.56.0",
    "@mastra/core": "^1.79.0",
    "@mastra/mcp": "^1.18.0",
    "ai": "^6.0.207",
    "convex": "^1.42.1",
    "openai": "7.43.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "convex-test": "^0.0.60",
    "mastra": "^1.31.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
